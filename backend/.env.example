# StoryFlow provider configuration. Copy to `backend/.env` (git-ignored) and edit.
# Real environment variables override this file. Nothing here is a secret: credentials are owned by
# the external tools themselves (e.g. the `claude` CLI login) and are never read or stored by StoryFlow.

# --- Subtitles (default: external = pinned Subtitle_supperVip via an isolated subprocess) -----------
# STORYFLOW_SUBTITLE_PROVIDER=external        # external | fake | none
# STORYFLOW_SUBTITLE_PYTHON=                   # interpreter that has backend/requirements-subtitle.txt installed
# STORYFLOW_SUBTITLE_TIMEOUT=60

# --- Story runner (default: none -> no text is sent to any model) ------------------------------------
# STORYFLOW_STORY_RUNNER=claude-cli            # none | claude-cli | fake
# STORYFLOW_CLAUDE_CLI=                        # path/name of `claude` (default: found on PATH)
# STORYFLOW_CLAUDE_MODEL=
# STORYFLOW_STORY_TIMEOUT=900

# --- TTS engine (default: none) ----------------------------------------------------------------------
# STORYFLOW_TTS_ENGINE=vieneu                  # none | vieneu | fake
# STORYFLOW_VIENEU_ROOT=                       # your local VieNeu-TTS checkout (its .venv is used)
# STORYFLOW_VIENEU_PYTHON=                     # optional interpreter override
# STORYFLOW_VIENEU_PRECISION=fp32              # fp32 | int8
# STORYFLOW_VIENEU_THREADS=6
# STORYFLOW_VIENEU_VOICE=
# STORYFLOW_TTS_TIMEOUT=1800

# --- Opt-in real smoke tests (never run by the normal suite) ---------------------------------------
# STORYFLOW_RUN_REAL_SMOKE=1
